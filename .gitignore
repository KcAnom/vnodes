# Per-machine agent configs. `vnodes setup` regenerates these and bakes an
# absolute path into them, so they are local-only. Claude Code reaches vnodes
# through the user-scope registration in ~/.claude.json instead.
.mcp.json
.cursor/
.gemini/
.claude/settings.local.json
