.vnodes/*
!.vnodes/manifest.json
node_modules/
*.log
.DS_Store

# Per-machine agent configs. Every in-repo config `vnodes setup` writes names
# an absolute project root, so none of them are portable: they are regenerated
# per machine by re-running setup, never committed. Keep this list in step with
# the in-repo entries in src/agents.js.
.mcp.json
.cursor/
.cline/
.claude/settings.local.json
# Not written by setup any more (Gemini registers at user scope), but Gemini
# itself still creates this for workspace state.
.gemini/

# mkmacapp output. The bundle is built from macapp.json, not committed.
dist/
